// A task for VS Code on a P1 login node. Copy this file to .vscode/tasks.json
// in your project on the cluster, then run "Tasks: Run Task". It calls
// aicentre on the login node, which keeps itself installed there. Submit jobs
// from VS Code's terminal with bsub on DTU or sbatch on Gefion; they show in
// the list too.
{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "My jobs",
      "type": "shell",
      "command": "$HOME/.local/bin/aicentre list jobs",
      "problemMatcher": []
    }
  ]
}
