{
  "name": "aicentre",
  "version": "0.1.1",
  "description": "Command line tool for the P1 HPC clusters",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run src/main.ts",
    "build": "bun run scripts/build.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint:sh": "shellcheck -s sh install.sh && shellcheck -s bash src/session/launcher.sh scripts/install-check.sh",
    "format": "prettier --write src test scripts",
    "lint": "prettier --check src test scripts"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^1.5.0",
    "typebox": "^1.3.27"
  }
}
